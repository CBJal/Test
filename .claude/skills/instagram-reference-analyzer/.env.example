# Copy this file to .env (or export these as real environment variables) and
# fill in your own values. Never commit a real .env file. This repo's
# .gitignore already covers .env, .env.local, .env.development, and
# .env.production — if you use a different filename, add it too.

# Required. Apify Console -> Settings -> Integrations -> Personal API token.
APIFY_API_TOKEN=

# Optional. Overrides the default Apify actor used for extraction.
# Default: apify/instagram-scraper
#APIFY_ACTOR_ID=apify/instagram-scraper

# Optional. Selects which extraction provider to use. Default: apify.
# See scripts/lib/providers/index.mjs for the registry of implemented providers.
#INSTAGRAM_PROVIDER=apify
